<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'">
<meta name="generator" content="ShipReady {{.Version}}">
<title>ShipReady report: {{.Cluster}}</title>
<style>{{.CSS}}</style>
</head>
<body>
<div class="page">

<header class="hero">
  <div class="hero-text">
    <p class="eyebrow">ShipReady <span aria-hidden="true">/</span> production readiness report</p>
    <h1>{{.Cluster}}</h1>
    <dl class="meta">
      <div><dt>Scanned</dt><dd>{{.ScanTime}}</dd></div>
      {{- if .KubernetesVersion}}<div><dt>Kubernetes</dt><dd>{{.KubernetesVersion}}</dd></div>{{end}}
      <div><dt>ShipReady</dt><dd>{{.Version}}</dd></div>
      <div><dt>Scope</dt><dd>{{if .Namespaces}}{{.Namespaces}}{{else}}Whole cluster{{end}}</dd></div>
    </dl>
    <p class="tally">
      <span class="tally-fail">{{.Summary.Failed}} failed</span>
      <span class="tally-pass">{{.Summary.Passed}} passed</span>
      <span class="tally-skip">{{.Summary.Skipped}} not run</span>
      <span class="tally-total">of {{.Total}} checks</span>
    </p>
  </div>
  <div class="score {{.GradeClass}}" role="img" aria-label="{{if .HasScore}}Overall score {{.Overall}} out of 100, grade {{.Grade}}{{else}}No overall score{{end}}">
    <svg viewBox="0 0 120 120" aria-hidden="true">
      <circle class="ring-track" cx="60" cy="60" r="52"/>
      {{- if .HasScore}}
      <circle class="ring-value" cx="60" cy="60" r="52" stroke-dasharray="{{.RingLength}}" stroke-dashoffset="{{.RingOffset}}"/>
      {{- end}}
    </svg>
    <div class="score-text">
      {{- if .HasScore}}
      <span class="score-number">{{.Overall}}</span>
      <span class="score-grade">Grade {{.Grade}}</span>
      {{- else}}
      <span class="score-number">n/a</span>
      <span class="score-grade">No check could run</span>
      {{- end}}
    </div>
  </div>
</header>

<section class="cards" aria-label="Scores by category">
  {{- range .Categories}}
  <a class="card {{.GradeClass}}" href="#cat-{{.Key}}">
    <h2>{{.Name}}</h2>
    <p class="card-score">
      {{- if .HasScore}}<span class="card-number">{{.Score}}</span><span class="card-grade">{{.Grade}}</span>
      {{- else}}<span class="card-number">n/a</span>{{end -}}
    </p>
    <div class="bar"><span style="width: {{.Score}}%"></span></div>
    <p class="card-counts">{{.Passed}} passed · {{.Failed}} failed · {{.Skipped}} not run</p>
  </a>
  {{- end}}
</section>

<section class="block" id="priorities">
  <h2>Top priorities</h2>
  {{- if .Top}}
  <p class="lede">Fix these first. They are the most severe problems found, ordered by how much damage they can do.</p>
  <ol class="priorities">
    {{- range .Top}}
    <li class="sev-{{.Severity}}">
      <div class="priority-head">
        <span class="badge">{{.SeverityLabel}}</span>
        <a class="check-id" href="#{{.ID}}">{{.ID}}</a>
        <span class="priority-title">{{md .Title}}</span>
        <span class="count">{{.Affected}}</span>
      </div>
      <p class="fix"><strong>Fix:</strong> {{md .Remediation}}</p>
    </li>
    {{- end}}
  </ol>
  {{- else}}
  <p class="lede">No check failed. Nothing needs fixing right now.</p>
  {{- end}}
</section>

<section class="block" id="findings">
  <div class="block-head">
    <h2>Findings by category</h2>
    {{- if .Summary.Failed}}
    <div class="toolbar" aria-label="Filter findings">
      <button type="button" data-filter="all" aria-pressed="true">All</button>
      <button type="button" data-filter="critical" aria-pressed="false">Critical</button>
      <button type="button" data-filter="high" aria-pressed="false">High</button>
      <button type="button" data-filter="medium" aria-pressed="false">Medium</button>
      <button type="button" data-filter="low" aria-pressed="false">Low</button>
      <span class="toolbar-gap"></span>
      <button type="button" data-action="expand">Expand all</button>
      <button type="button" data-action="collapse">Collapse all</button>
    </div>
    {{- end}}
  </div>

  {{- range .Categories}}
  <div class="category" id="cat-{{.Key}}">
    <h3>{{.Name}} <span class="category-note">{{.Blurb}}</span></h3>
    {{- range .Findings}}
    <details class="finding sev-{{.Severity}}" id="{{.ID}}" data-severity="{{.Severity}}">
      <summary>
        <span class="badge">{{.SeverityLabel}}</span>
        <span class="check-id">{{.ID}}</span>
        <span class="finding-title">{{md .Title}}</span>
        <span class="count">{{.Affected}}</span>
      </summary>
      <div class="finding-body">
        <div class="explain">
          <div>
            <h4>Why it matters</h4>
            <p>{{md .Description}}</p>
          </div>
          <div>
            <h4>How to fix it</h4>
            <p>{{md .Remediation}}</p>
            {{- if .Snippet}}
            <div class="snippet">
              <button type="button" class="copy" data-action="copy">Copy</button>
              <pre><code>{{.Snippet}}</code></pre>
            </div>
            {{- end}}
          </div>
        </div>
        <h4>Affected resources ({{len .Resources}})</h4>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Kind</th>
                {{- if .ShowNamespace}}<th>Namespace</th>{{end}}
                <th>Name</th>
                {{- if .ShowContainer}}<th>Container</th>{{end}}
                <th>What is wrong</th>
              </tr>
            </thead>
            <tbody>
              {{- $f := .}}
              {{- range .Resources}}
              <tr>
                <td>{{.Kind}}</td>
                {{- if $f.ShowNamespace}}<td>{{.Namespace}}</td>{{end}}
                <td class="mono">{{.Name}}</td>
                {{- if $f.ShowContainer}}<td class="mono">{{.Container}}</td>{{end}}
                <td>{{.Detail}}</td>
              </tr>
              {{- end}}
            </tbody>
          </table>
        </div>
      </div>
    </details>
    {{- end}}
    {{- if not .Findings}}
    <p class="all-clear">{{if .Passed}}Every check that ran in this category passed.{{else}}No check in this category could run.{{end}}</p>
    {{- end}}
    <p class="no-match" hidden>No findings of this severity in {{.Name}}.</p>
    {{- if .PassedChecks}}
    <details class="passed">
      <summary>{{len .PassedChecks}} passed</summary>
      <ul>
        {{- range .PassedChecks}}
        <li><span class="check-id">{{.ID}}</span> {{md .Title}}</li>
        {{- end}}
      </ul>
    </details>
    {{- end}}
  </div>
  {{- end}}
</section>

{{- if .Skipped}}
<section class="block" id="skipped">
  <h2>Checks that did not run</h2>
  <p class="lede">These are not counted in the score. Each one says what stopped it, so you know what this report does not cover.</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Check</th><th>What it looks for</th><th>Why it did not run</th></tr></thead>
      <tbody>
        {{- range .Skipped}}
        <tr>
          <td class="mono nowrap">{{.ID}}</td>
          <td>{{md .Title}}</td>
          <td>{{.SkipReason}}</td>
        </tr>
        {{- end}}
      </tbody>
    </table>
  </div>
</section>
{{- end}}

<section class="cta">
  <div>
    <h2>Want this fixed in a week?</h2>
    <p>Opscify engineers can work through this list with your team and leave you with a production-ready cluster.</p>
  </div>
  {{- if .CTAURL}}
  <a class="cta-button" href="{{.CTAURL}}" rel="noopener noreferrer">Book a call</a>
  {{- end}}
</section>

<footer>
  <p>Generated by ShipReady {{.Version}} on your own machine, with read-only access. Nothing in this report was sent anywhere, and no Secret was read.</p>
</footer>

</div>
<script>{{.JS}}</script>
</body>
</html>
